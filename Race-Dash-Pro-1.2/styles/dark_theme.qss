/* Глобальные стили */
QWidget {
    background-color: #0a0f1a;
    color: #ffffff;
    font-family: 'Roboto Mono', monospace;
    font-size: 12px;
}

/* Стиль для кнопок */
QPushButton {
    background: #1a1f2a;
    color: #00ffff;
    border: 1px solid #00ffff;
    border-radius: 30px;
    padding: 8px 20px;
    font-weight: bold;
}

QPushButton:hover {
    background: #00ffff;
    color: #000000;
}

QPushButton:pressed {
    background: #00ccdd;
    border: 1px solid #00ccdd;
}

/* Стиль для тахометра */
ProfessionalGauge {
    background: transparent;
}

/* Стиль для датчиков */
SensorCard {
    background-color: #14171c;
    border-radius: 14px;
    border-left: 4px solid;
}

/* Стиль для логов */
LogsScreen QListWidget {
    background-color: #1e1e2f;
    border: 1px solid #444;
    border-radius: 12px;
    padding: 10px;
    color: #ccc;
    font-size: 12px;
}

LogsScreen QListWidget::item {
    padding: 10px;
    border-bottom: 1px solid #333;
}